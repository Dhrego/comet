---
import HamburgerMenu from "./HamburgerMenu.astro";
import Logo from "./Logo.astro";
import { lenis } from "../scripts/lenisInstance.js";
import { navlinks } from "../config";

const currentPath = Astro.url.pathname === "/me";
---

<>
  <div id="nav-marker" style="height: 1px;"></div>
  <nav>
    <a href="/" class="logo" aria-label="Andrea — home">
      <Logo />
    </a>
    <HamburgerMenu data="navbar1" items={navlinks} />
  </nav>
  {
    !currentPath && (
      <div class="sticky_one" inert>
        <a href="/" class="logo" aria-label="Andrea — home">
          <Logo />
        </a>
        <HamburgerMenu data="navbar2" items={navlinks} />
      </div>
    )
  }
</>

<style>
  .sticky_one {
    position: fixed;
    width: 100%;
    top: 0;
    z-index: 9999;
    background-color: rgba(0, 0, 0, 0.2);
    transform: translateY(-100%);
    transition: all 0.3s ease;
    box-shadow: 0 0.25px 0 rgb(255, 255, 255);
  }
  .sticky_one::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    backdrop-filter: blur(10px);
    z-index: -1;
  }

  .sticky_one.sticky {
    transform: translate(0);
    transition: transform 0.3s ease;
  }

  nav,
  .sticky_one {
    display: flex;
    justify-content: space-between;
    /* border-radius: 0 0 16px 16px; */
    margin: 0 auto;
    padding-block: 24px;
    padding-inline: 32px;
  }

  @media screen and (max-width: 900px) {
    nav {
      position: relative;
    }
  }

  @media screen and (max-width: 530px) {
    nav,
    .sticky_one {
      border-radius: 0;
      width: 100%;
      padding-inline: 10px;
      padding-block: 16px;
      align-items: center;
    }

    .hamburger-menu {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
  }
</style>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    if (window.location.pathname !== "/me") {
      const nav = document.querySelector(".sticky_one");
      const navMarker = document.getElementById("nav-marker");

      const observerOptions = {
        root: null,
        rootMargin: "20% 0px 0px 0px",
        threshold: 0,
      };

      const observer = new IntersectionObserver((entries) => {
        const [entry] = entries;
        if (!entry.isIntersecting) {
          nav.classList.add("sticky");
          nav.removeAttribute("inert");
        } else {
          nav.classList.remove("sticky");
          nav.setAttribute("inert", "");
        }
      }, observerOptions);

      observer.observe(navMarker);
    }
  });
</script>
