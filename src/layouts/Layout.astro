---
import "../styles/app.css";
import "../fonts/stylesheet.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import Cursor from "../components/Cursor.astro";
import FontPreloader from "../components/FontPreloader.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";

const { title, description } = Astro.props;
const SITE_NAME = "Andrea";
const SITE_ALT_NAME = "Dhrego"; // the string people actually search for
const PERSON_NAME = "Andrea";
const JOB_TITLE = "Designer & Developer";
const SITE_URL = "https://www.dhrego.com";
const OgImage = `${SITE_URL}/OG.png`;
// Construct the canonical URL without trailing slash
const canonicalURL = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site).href;

// Tells Google who owns this site, so "dhrego" resolves to a known entity
// instead of an unrecognised string. alternateName is what ties the domain
// name to the person; it is never displayed.
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      url: SITE_URL,
      name: SITE_NAME,
      description:
        "Portfolio of Andrea, a designer and developer building fast, considered websites and digital products.",
      inLanguage: "en",
      publisher: { "@id": `${SITE_URL}/#person` },
    },
    {
      "@type": "Person",
      "@id": `${SITE_URL}/#person`,
      name: PERSON_NAME,
      alternateName: SITE_ALT_NAME,
      jobTitle: JOB_TITLE,
      url: SITE_URL,
      image: OgImage,
      email: "mailto:work@dhrego.com",
      sameAs: ["https://github.com/Dhrego"],
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: title,
      description: description,
      isPartOf: { "@id": `${SITE_URL}/#website` },
      about: { "@id": `${SITE_URL}/#person` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- FB -->
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={OgImage} />

    <!-- Twitter-->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="www.dhrego.com" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OgImage} />

    <FontPreloader />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Preload the image -->

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <link rel="preload" href="img-group.png" as="image" /></head
  >

  <body>
    <Analytics />
    <Navbar />
    <slot />
    <Cursor />
    <Footer />

    <script is:inline>
      function speedInsightsBeforeSend(data) {
        console.log("Speed Insights before send", data);
        return data;
      }
    </script>
    <SpeedInsights />
    <script>
      const changeColor = (index: number) => {
        root.style.setProperty("--base-color", colors[index]);
        logoSvg.forEach((logo) => logo.setAttribute("fill", colors[index]));

        // logoSvg.setAttribute("fill", colors[index]);

        index = (index + 1) % colors.length;

        setTimeout(() => {
          changeColor(index);
        }, 5000);
      };

      const colors = [
        "#8aaae5",
        "#f77126",
        "#26f7ac",
        "#26c5f7",
        "#d439d7",
        "#e04c4c",
      ];

      let root = document.documentElement;
      let logoSvg = document.querySelectorAll(".logo svg path");

      changeColor(0);
    </script>
    <script src="../scripts/app.js"></script>
  </body>
</html>
